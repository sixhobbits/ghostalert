#!/usr/bin/env bash
# Claude Code hook: push this tab's state to ghostalert.
#
#   ghostalert-claude-hook <state> [message]
#
# The state is one of idle, working, waiting, done, error. With no message, the
# hook uses the one Claude supplies (Notification events carry the reason it is
# asking for you) and otherwise the session's working directory.
#
# It always exits 0. A status tile is never worth failing a turn over.
set -uo pipefail

state="${1:-working}"
message="${2:-}"

input=""
if [ ! -t 0 ]; then
  input=$(cat)
fi

if [ -z "$message" ] && [ -n "$input" ] && command -v jq >/dev/null 2>&1; then
  message=$(printf '%s' "$input" | jq -r '.message // empty' 2>/dev/null)
  if [ -z "$message" ]; then
    cwd=$(printf '%s' "$input" | jq -r '.cwd // empty' 2>/dev/null)
    [ -n "$cwd" ] && message=$(basename "$cwd")
  fi
fi

command -v ghostalert >/dev/null 2>&1 || exit 0
ghostalert set "$state" "$message" >/dev/null 2>&1 || true
exit 0
